{
  "name": "ledger_api",
  "version": "1.0.0",
  "description": "Double-entry banking ledger API (TypeScript, Express, MongoDB, Redis)",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node dist/server.js\" --onFailure \"echo Build failed\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:e2e",
    "test:e2e": "node tests/api.e2e.mjs",
    "promote:admin": "ts-node scripts/promote-admin.ts",
    "infra:up": "docker compose up -d mongo redis",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile api up -d --build",
    "stack:logs": "docker compose logs -f api"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Somilg11/ledger_api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Somilg11/ledger_api/issues"
  },
  "homepage": "https://github.com/Somilg11/ledger_api#readme",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "rate-limiter-flexible": "^9.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
}
