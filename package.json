{
  "name": "ledger_api",
  "version": "1.0.0",
  "description": "Double-entry banking ledger API (TypeScript, Express, MongoDB, Redis)",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node dist/server.js\" --onFailure \"echo Build failed\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "node tests/api.e2e.mjs",
    "promote:admin": "ts-node scripts/promote-admin.ts",
    "infra:up": "docker compose up -d mongo redis",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile web up -d --build",
    "stack:logs": "docker compose logs -f api web",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "seed": "node scripts/seed-demo.mjs",
    "test:ui": "npm --prefix web run test:ui",
    "stack:stop": "docker compose --profile web stop",
    "stack:down": "docker compose --profile web down",
    "stack:reset": "docker compose --profile web down -v",
    "stack:ps": "docker compose --profile web ps",
    "test:unit": "tsx --test \"tests/unit/*.test.ts\"",
    "docs:openapi": "tsx scripts/emit-openapi.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Somilg11/ledger_api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Somilg11/ledger_api/issues"
  },
  "homepage": "https://github.com/Somilg11/ledger_api#readme",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^9.1.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.2",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
