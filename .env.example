# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database ----
# Multi-document transactions require a replica set. docker-compose.yml
# provides a single-node one out of the box.
MONGO_URI=mongodb://localhost:27017/ledger?replicaSet=rs0

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
# Generate with: openssl rand -hex 32
# In production the app refuses to start if these are missing or shorter than
# 32 characters.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
JWT_ISSUER=ledger-api
JWT_AUDIENCE=ledger-api-clients

# ---- Security ----
BCRYPT_ROUNDS=12
# Number of proxy hops in front of the app (leave unset when not behind one).
# TRUST_PROXY=1
CORS_ORIGINS=http://localhost:5173
MAX_FAILED_LOGINS=5
LOGIN_LOCK_SECONDS=900

# ---- Rate limiting ----
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

# ---- Email ----
# Mail is mocked: nothing is delivered and verification links come back in the
# API response so the console can show them. Production ignores this and always
# behaves as if it were false - returning a verification link to whoever called
# /auth/register would let anyone verify an address they do not control.
MOCK_EMAIL=true
# Base URL used to build links in mocked mail.
APP_URL=http://localhost:8080
EMAIL_VERIFICATION_TTL_SECONDS=86400
# Block money movement until the address is verified. Off by default so the
# simulation works immediately.
REQUIRE_EMAIL_VERIFICATION=false

# ---- Ledger ----
SUPPORTED_CURRENCIES=INR,USD,EUR,GBP
# Amounts are integers in minor units (paise/cents). 100000000 = 10,00,000.00
MAX_TRANSFER_MINOR_UNITS=100000000
MAX_PAGE_SIZE=100
# Lets a user fund their own account. Simulation convenience; defaults to false
# in production, where only an ADMIN may create money.
ALLOW_SELF_DEPOSIT=true
